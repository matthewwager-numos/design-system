{
  "name": "@numosai/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "React component library — mirrors the Figma design system.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "tsc --noEmit",
    "stylelint": "stylelint \"src/**/*.css\"",
    "stylelint:json": "mkdir -p test-results && stylelint \"src/**/*.css\" --formatter json --output-file test-results/stylelint-results.json",
    "depgraph": "mkdir -p depgraph && depcruise --output-type json src > depgraph/graph.json && depcruise --validate --output-type err src",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@numosai/tokens": "workspace:*",
    "clsx": "^2.1.0",
    "lucide-react": "^1.31.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "dependency-cruiser": "^16.4.2",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.2.0",
    "vitest": "^2.1.4"
  }
}
