{
  "name": "design-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A React component library, design tokens, and illustration/animation tools — all in one monorepo.",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "storybook": "pnpm --filter @numosai/storybook dev",
    "playgrounds": "pnpm --filter @numosai/playgrounds dev",
    "demo": "pnpm --filter @numosai/demo dev",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  }
}
