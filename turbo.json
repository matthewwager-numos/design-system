{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "stylelint": {},
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["test-results/**"]
    },
    "depgraph": {
      "outputs": ["depgraph/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
